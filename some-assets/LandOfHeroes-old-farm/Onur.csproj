<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Onur</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <Optimize>True</Optimize>
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <Deterministic>True</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="-048C---" />
    <None Remove="-04AF---" />
    <EmbeddedResource Include="-048C---" LogicalName="‌048C‍‎‍" />
    <EmbeddedResource Include="-04AF---" LogicalName="‌04AF‎‍​" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Core\SessionAgent.py" LogicalName="Onur.SessionAgent.py" />
    <EmbeddedResource Include="Core\MountSkillCycle.py" LogicalName="Onur.MountSkillCycle.py" />
    <EmbeddedResource Include="Core\NormalAttackHold.py" LogicalName="Onur.NormalAttackHold.py" />
    <EmbeddedResource Include="Core\RouteMotion.py" LogicalName="Onur.RouteMotion.py" />
    <Reference Include="System.Core" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Guna.UI2">
      <HintPath>lib\Guna.UI2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <EmbeddedResource Include="lib\Guna.UI2.dll" LogicalName="Onur.Guna.UI2.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="BridgeHost\**\*.cs" />
    <Compile Remove="yedek\**" />
    <None Remove="yedek\**" />
    <EmbeddedResource Remove="yedek\**" />
  </ItemGroup>
</Project>
