@implements IDisposable
@inject FarmBotShell Shell

<aside class="player-rail">
    <div class="player-card">
        <div class="player-id">
            <div class="avatar @(HasAvatar ? "" : "empty")">
                @if (HasAvatar)
                {
                    <img src="@AvatarSrc" alt="@RaceCaption" />
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="9" r="3.2" />
                        <path d="M6.2 18.2c.9-3.1 3.2-4.6 5.8-4.6s4.9 1.5 5.8 4.6" />
                    </svg>
                }
            </div>
            <div class="player-copy">
                <div class="player-name">@Name</div>
                <div class="player-meta">Lv @Level@(string.IsNullOrEmpty(RaceCaption) ? "" : $" · {RaceCaption}")</div>
                <div class="player-pos">@Map · @Position</div>
            </div>
        </div>
        <div class="meter">
            <span>HP</span>
            <div class="track"><div class="fill hp" style="width:@Pct(Player?.Hp ?? 0, Player?.MaxHp ?? 0)"></div></div>
            <b>@Frac(Player?.Hp, Player?.MaxHp)</b>
        </div>
        <div class="meter">
            <span>MP</span>
            <div class="track"><div class="fill mp" style="width:@Pct(Player?.Mp ?? 0, Player?.MaxMp ?? 0)"></div></div>
            <b>@Frac(Player?.Mp, Player?.MaxMp)</b>
        </div>
        <div class="meter">
            <span>EXP</span>
            <div class="track"><div class="fill exp" style="width:@Pct(Player?.Exp ?? 0, Player?.NextExp ?? 0)"></div></div>
            <b>@Frac(Player?.Exp, Player?.NextExp)</b>
        </div>
    </div>
    <div class="rail-map">
        <Minimap />
    </div>
    <div class="rail-status">
        <span>@(Shell.IsLive ? "live" : "sim")</span>
        <span>@Shell.CompanionStatus</span>
        <span>@((Shell.View.Snapshot?.Entities.Count ?? 0)) ents</span>
    </div>
</aside>

@code {
    private PlayerState? Player => Shell.View.Snapshot?.Player;

    private string Name => string.IsNullOrWhiteSpace(Player?.Name) ? "—" : Player!.Name;

    private string Level => Player is { Level: > 0 } ? Player.Level.ToString() : "—";

    private string Position => Player == null ? "—" : $"{Player.X:0}, {Player.Y:0}";

    private string Map => string.IsNullOrWhiteSpace(Player?.MapName) ? "no map" : Player!.MapName;

    private string AvatarSrc => PlayerAvatar.Src(Player?.Race);

    private bool HasAvatar => AvatarSrc.Length > 0;

    private string RaceCaption => PlayerRace.Caption(Player?.Race);

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;

    private static string Frac(int? current, int? max) =>
        max is > 0 ? $"{current ?? 0}/{max}" : "—";

    private static string Pct(int current, int max)
    {
        if (max <= 0 || current <= 0)
            return "0%";
        return $"{Math.Clamp(100.0 * current / max, 0, 100):0}%";
    }
}
