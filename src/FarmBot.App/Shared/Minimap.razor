@using System.Globalization
@implements IDisposable
@inject FarmBotShell Shell

<div class="minimap-wrap">
    <div class="minimap-stage">
        @if (!string.IsNullOrEmpty(Shell.AtlasUrl))
        {
            <img class="minimap-atlas" src="@Shell.AtlasUrl" alt="" />
        }
        <svg class="minimap" viewBox="0 0 @N(MapW) @N(MapH)" aria-label="Farm map">
            <rect x="0.5" y="0.5" width="@N(MapW - 1)" height="@N(MapH - 1)" rx="8" fill="@(string.IsNullOrEmpty(Shell.AtlasUrl) ? "#0e1016" : "transparent")" stroke="rgba(232,228,218,0.12)" />
            <ellipse cx="@N(Cx)" cy="@N(Cy)" rx="@N(FarmRx)" ry="@N(FarmRy)" fill="none" stroke="rgba(196,120,58,0.55)" stroke-width="1.2" />
            @if (Shell.Config.RangedAttackEnabled)
            {
                <ellipse cx="@N(Cx)" cy="@N(Cy)" rx="@N(RangedRx)" ry="@N(RangedRy)" fill="none" stroke="rgba(74,126,196,0.7)" stroke-width="1.2" stroke-dasharray="4 3" />
            }
            @foreach (var mark in Marks)
            {
                <circle cx="@N(mark.X)" cy="@N(mark.Y)" r="@(mark.Target ? 3.6 : 2.4)" fill="@mark.Fill">
                    <title>@mark.Label</title>
                </circle>
                @if (mark.Target)
                {
                    <circle cx="@N(mark.X)" cy="@N(mark.Y)" r="6.2" fill="none" stroke="#d9a06a" stroke-width="1.2" />
                }
            }
            <g transform="rotate(@N(Facing), @N(Cx), @N(Cy))">
                <polygon points="@N(Cx),@N(Cy - 7) @N(Cx + 5.2),@N(Cy + 6) @N(Cx),@N(Cy + 2.4) @N(Cx - 5.2),@N(Cy + 6)" fill="#c4783a" />
            </g>
        </svg>
    </div>
    <div class="minimap-legend">
        <span><i class="dot-mob"></i>mobs</span>
        <span><i class="dot-stone"></i>stones</span>
        <span><i class="dot-boss"></i>bosses</span>
    </div>
    <div class="radius-fields">
        <label class="slider">
            <span>Farm radius <b>@Shell.Config.FarmRadius.ToString("0")</b></span>
            <input type="range" min="1000" max="8000" step="25" value="@Shell.Config.FarmRadius.ToString(CultureInfo.InvariantCulture)" @oninput="OnFarmRadius" />
        </label>
        <label class="slider">
            <span>Zoom <b>@Shell.Config.MapZoom.ToString("0")</b></span>
            <input type="range" min="20" max="100" step="1" value="@Shell.Config.MapZoom.ToString(CultureInfo.InvariantCulture)" @oninput="OnZoom" />
        </label>
    </div>
</div>

@code {
    private const double MapW = 240;
    private const double MapH = 150;
    private const double Cx = 120;
    private const double Cy = 75;
    private const double HalfW = 114;
    private const double HalfH = 70;

    private sealed record Mark(double X, double Y, string Fill, string Label, bool Target);

    private IReadOnlyList<Mark> Marks => BuildMarks();

    private double ViewRadius => Shell.MapViewRadius;

    private double FarmRx => Math.Clamp(HalfW * Shell.Config.FarmRadius / ViewRadius, 4, HalfW);
    private double FarmRy => Math.Clamp(HalfH * Shell.Config.FarmRadius / ViewRadius, 4, HalfH);
    private double RangedRx => Math.Clamp(HalfW * Shell.Config.RangedAttackRadius / ViewRadius, 4, HalfW);
    private double RangedRy => Math.Clamp(HalfH * Shell.Config.RangedAttackRadius / ViewRadius, 4, HalfH);

    private float Facing => Shell.View.Snapshot?.Player.FacingDeg ?? 0;

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;

    private void OnFarmRadius(ChangeEventArgs e)
    {
        if (float.TryParse(Convert.ToString(e.Value, CultureInfo.InvariantCulture), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            Shell.SetFarmRadius(value);
    }

    private void OnZoom(ChangeEventArgs e)
    {
        if (float.TryParse(Convert.ToString(e.Value, CultureInfo.InvariantCulture), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            Shell.SetMapZoom(value);
    }

    private IReadOnlyList<Mark> BuildMarks()
    {
        var view = Shell.View;
        var snapshot = view.Snapshot;
        if (snapshot == null)
            return Array.Empty<Mark>();

        var player = snapshot.Player;
        var scaleX = HalfW / ViewRadius;
        var scaleY = HalfH / ViewRadius;
        var bosses = Shell.BossVnums().ToHashSet();
        var marks = new List<Mark>();
        foreach (var entity in snapshot.Entities)
        {
            if (!TryColor(entity, bosses, out var fill))
                continue;
            var dx = (entity.X - player.X) * scaleX;
            var dy = (entity.Y - player.Y) * scaleY;
            if (Math.Abs(dx) > HalfW || Math.Abs(dy) > HalfH)
                continue;
            var label = string.IsNullOrWhiteSpace(entity.Name)
                ? $"{EntityMapping.TypeName(entity.ResolvedType)}  VNUM {entity.Vnum}  {entity.Distance:0}"
                : $"{entity.Name}  VNUM {entity.Vnum}  {entity.Distance:0}";
            marks.Add(new Mark(Cx + dx, Cy - dy, fill, label, view.Target?.Vid == entity.Vid));
        }

        return marks;
    }

    private static string N(double value) => value.ToString("0.0", CultureInfo.InvariantCulture);

    private static bool TryColor(EntityState entity, HashSet<uint> bosses, out string fill)
    {
        if (entity.Kind == EntityKind.Boss || bosses.Contains(entity.Vnum))
        {
            fill = "#d4a017";
            return true;
        }

        if (entity.ResolvedType == ActorType.Stone || entity.Kind == EntityKind.Metin)
        {
            fill = "#ece8df";
            return true;
        }

        if (entity.ResolvedType == ActorType.Enemy || entity.Kind == EntityKind.Monster)
        {
            fill = "#c45c5c";
            return true;
        }

        fill = "";
        return false;
    }
}
