@inherits LayoutComponentBase
@implements IDisposable
@inject FarmBotShell Shell
@inject ThemeService Themes
@inject IJSRuntime JS

<div class="shell">
    <header class="topbar">
        <div class="brand">
            <b>FarmBot</b>
            <span>companion console</span>
        </div>
        <div class="cmd">
            <button class="btn btn-ok" disabled="@(Shell.View.Enabled)" @onclick="Shell.StartBot">Start</button>
            <button class="btn btn-danger" disabled="@(!Shell.View.Enabled)" @onclick="Shell.StopBot">Stop</button>
            <button class="btn btn-save" @onclick="Shell.SaveSettings">Save</button>
        </div>
        <span class="pill @(Shell.View.Enabled ? "on" : "off")"><i></i>@(Shell.RangedOnly ? "Ranged" : Shell.View.Enabled ? "Running" : "Stopped")</span>
        <select @bind="Shell.ModeIndex" @bind:event="onchange">
            <option value="1">Live</option>
            <option value="0">Simulator</option>
        </select>
        <select class="client" disabled="@(!Shell.IsLive)" @bind="Shell.SelectedClientPid">
            @if (Shell.Clients.Count == 0)
            {
                <option value="0">no client</option>
            }
            else
            {
                @foreach (var client in Shell.Clients)
                {
                    <option value="@client.ProcessId">@client.ToString()</option>
                }
            }
        </select>
        <button class="btn" disabled="@(!Shell.IsLive)" @onclick="Shell.AttachSelectedClient">Attach</button>
        <button class="btn" disabled="@(!Shell.IsLive)" @onclick="Shell.LaunchClient">Launch</button>
        <div class="theme-wrap">
            <button type="button" class="theme-btn" @onclick="ToggleThemeMenu" title="Theme">
                <span class="theme-swatch" aria-hidden="true">
                    <i style="background:@Themes.Current.SwatchA"></i>
                    <i style="background:@Themes.Current.SwatchB"></i>
                    <i style="background:@Themes.Current.SwatchC"></i>
                </span>
                @Themes.Current.Name
                <svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 7 L8 3.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
            </button>
            @if (_themeOpen)
            {
                <div class="theme-menu">
                    @foreach (var theme in ThemeService.All)
                    {
                        <button type="button" class="theme-opt @(theme.Id == Themes.CurrentId ? "on" : null)" @onclick="() => PickTheme(theme.Id)">
                            <span class="theme-swatch" aria-hidden="true">
                                <i style="background:@theme.SwatchA"></i>
                                <i style="background:@theme.SwatchB"></i>
                                <i style="background:@theme.SwatchC"></i>
                            </span>
                            @theme.Name
                        </button>
                    }
                </div>
            }
        </div>
        @if (_themeOpen)
        {
            <div class="theme-back" @onclick="CloseThemeMenu"></div>
        }
        <span class="stats">@Shell.CompanionStatus</span>
    </header>

    <nav class="sidebar">
        <div class="nav-group">
            <div class="nav-head open"><span>Operations</span></div>
            <div class="nav-items open">
                <div>
                    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Farm</NavLink>
                    <NavLink class="nav-item" href="ranged">Ranged Attack</NavLink>
                    <NavLink class="nav-item" href="settings">Settings</NavLink>
                    <NavLink class="nav-item" href="log">Log</NavLink>
                </div>
            </div>
        </div>
    </nav>

    <main class="main">
        <div class="tabstrip">
            <NavLink class="tab" href="" Match="NavLinkMatch.All" ActiveClass="on">Farm</NavLink>
            <NavLink class="tab" href="ranged" ActiveClass="on">Ranged Attack</NavLink>
            <NavLink class="tab" href="settings" ActiveClass="on">Settings</NavLink>
            <NavLink class="tab" href="log" ActiveClass="on">Log</NavLink>
        </div>
        <div class="workspace">
            <div class="workspace-page on">
                @Body
            </div>
        </div>
    </main>

    <footer class="status @Shell.StatusKind">
        <span>@(Shell.IsLive ? "live" : "simulator")</span>
        <span>@Shell.CompanionStatus</span>
        <span>@((Shell.View.Snapshot?.Entities.Count ?? 0)) entities</span>
        <span>@Shell.StatusLine</span>
    </footer>
</div>

@code {
    private bool _themeOpen;
    private bool _themeApplied;

    protected override void OnInitialized()
    {
        Shell.Changed += OnChanged;
        Themes.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_themeApplied)
        {
            _themeApplied = true;
            await Themes.SelectAsync(Themes.CurrentId, JS);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleThemeMenu() => _themeOpen = !_themeOpen;

    private void CloseThemeMenu() => _themeOpen = false;

    private async Task PickTheme(string id)
    {
        _themeOpen = false;
        await Themes.SelectAsync(id, JS);
    }

    public void Dispose()
    {
        Shell.Changed -= OnChanged;
        Themes.Changed -= OnChanged;
    }
}
