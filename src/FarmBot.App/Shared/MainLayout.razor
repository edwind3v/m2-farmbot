@inherits LayoutComponentBase
@implements IDisposable
@inject FarmBotShell Shell
@inject ThemeService Themes
@inject IJSRuntime JS

<div class="shell">
    <TitleBar>
        <Brand>
            <div class="brand">
                <b>FarmBot</b>
                <span>console</span>
            </div>
            <div class="session-clock @(Shell.View.Enabled ? "on" : null)" title="Farm session time">
                <Icons Name="clock" />
                <span>@Shell.FarmedElapsedText</span>
            </div>
            <div class="kill-box" title="Metin stones">
                <img src="@KillIcon.Stone" alt="Metin Stone" />
                <b>@Shell.StoneKills</b>
            </div>
            <div class="kill-box boss" title="Bosses">
                <img src="@KillIcon.Boss" alt="Boss" />
                <b>@Shell.BossKills</b>
            </div>
        </Brand>
        <Actions>
            <div class="cmd">
                <button class="btn btn-ok" disabled="@(Shell.View.Enabled)" @onclick="Shell.StartBot">Start</button>
                <button class="btn btn-danger" disabled="@(!Shell.View.Enabled)" @onclick="Shell.StopBot">Stop</button>
                <button class="btn btn-save" @onclick="Shell.SaveSettings">Save</button>
            </div>
            <span class="pill @(Shell.View.Enabled ? "on" : "off")"><i></i>@(Shell.RangedOnly ? "Ranged" : Shell.View.Enabled ? "Running" : "Stopped")</span>
            <select value="@Shell.ModeIndex" @onchange="OnModeChanged">
                <option value="1">Live</option>
                <option value="0">Sim</option>
            </select>
            <div class="theme-wrap">
                <button type="button" class="theme-btn" @onclick="ToggleThemeMenu" title="Theme">
                    <span class="theme-swatch" aria-hidden="true">
                        <i style="background:@Themes.Current.SwatchA"></i>
                        <i style="background:@Themes.Current.SwatchB"></i>
                        <i style="background:@Themes.Current.SwatchC"></i>
                    </span>
                    <svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 7 L8 3.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
                </button>
                @if (_themeOpen)
                {
                    <div class="theme-menu">
                        @foreach (var theme in ThemeService.All)
                        {
                            <button type="button" class="theme-opt @(theme.Id == Themes.CurrentId ? "on" : null)" @onclick="() => PickTheme(theme.Id)">
                                <span class="theme-swatch" aria-hidden="true">
                                    <i style="background:@theme.SwatchA"></i>
                                    <i style="background:@theme.SwatchB"></i>
                                    <i style="background:@theme.SwatchC"></i>
                                </span>
                                @theme.Name
                            </button>
                        }
                    </div>
                }
            </div>
            @if (_themeOpen)
            {
                <div class="theme-back" @onclick="CloseThemeMenu"></div>
            }
        </Actions>
    </TitleBar>

    <div class="shell-body">
        <PlayerRail />
        <main class="main">
            <div class="tabstrip">
                <NavLink class="tab" href="" Match="NavLinkMatch.All" ActiveClass="on"><Icons Name="sword" />Farm</NavLink>
                <NavLink class="tab" href="ranged" ActiveClass="on"><Icons Name="crosshair" />Ranged</NavLink>
                <NavLink class="tab" href="entities" ActiveClass="on"><Icons Name="list" />Entities</NavLink>
                <NavLink class="tab" href="settings" ActiveClass="on"><Icons Name="sliders" />Settings</NavLink>
                <NavLink class="tab" href="log" ActiveClass="on"><Icons Name="log" />Log</NavLink>
            </div>
            <div class="workspace">
                <div class="workspace-page on">
                    @Body
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private bool _themeOpen;
    private bool _themeApplied;
    private CancellationTokenSource? _refresh;

    protected override void OnInitialized()
    {
        Shell.Changed += OnChanged;
        Themes.Changed += OnChanged;
        _refresh = new CancellationTokenSource();
        _ = RefreshLoop(_refresh.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_themeApplied)
        {
            _themeApplied = true;
            await Themes.SelectAsync(Themes.CurrentId, JS);
        }
    }

    private async Task RefreshLoop(CancellationToken token)
    {
        try
        {
            await InvokeAsync(() =>
            {
                Shell.Tick();
                StateHasChanged();
            });
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    Shell.Tick();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnModeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var mode))
            Shell.ModeIndex = mode;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleThemeMenu() => _themeOpen = !_themeOpen;

    private void CloseThemeMenu() => _themeOpen = false;

    private async Task PickTheme(string id)
    {
        _themeOpen = false;
        await Themes.SelectAsync(id, JS);
    }

    public void Dispose()
    {
        _refresh?.Cancel();
        _refresh?.Dispose();
        Shell.Changed -= OnChanged;
        Themes.Changed -= OnChanged;
    }
}
