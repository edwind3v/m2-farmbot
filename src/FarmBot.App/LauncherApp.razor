@inject LauncherShell Shell
@inject ThemeService Themes
@inject IJSRuntime JS
@implements IDisposable

<div class="launcher">
    <TitleBar>
        <Brand>
            <div class="brand">
                <b>FarmBot</b>
                <span>launcher</span>
            </div>
        </Brand>
        <Actions>
            <label class="profile-label">
                Mode
                <select class="profile" value="@Shell.ProfileName" @onchange="OnProfileChanged">
                    <option value="Arthion">Arthion</option>
                    <option value="Baerim">Baerim</option>
                    <option value="Normal">Normal</option>
                </select>
            </label>
            <button class="btn btn-save" @onclick="Shell.AddSlot">+ Slot</button>
        </Actions>
    </TitleBar>

    <div class="launch-body">
        <div class="field-row">
            <label>Client</label>
            <input @bind="Shell.ClientPath" />
        </div>
        <p class="launch-status">@Shell.Status</p>

        @foreach (var slot in Shell.VisibleSlots)
        {
            <div class="slot @(Shell.IsRunning(slot) ? "on" : null) @(Shell.IsBusy(slot) ? "busy" : null)">
                <div class="slot-main">
                    <b>@slot.DisplayName</b>
                    <span class="slot-state">
                        @if (Shell.IsBusy(slot))
                        {
                            <span class="spinner" aria-hidden="true"></span>
                        }
                        @Shell.SessionStatus(slot)
                    </span>
                </div>
                <div class="slot-cmd">
                    <button class="btn btn-ok" disabled="@(Shell.SlotsLocked || Shell.IsRunning(slot))" @onclick="() => Shell.Play(slot)">Play</button>
                    <button class="btn" disabled="@Shell.SlotsLocked" @onclick="() => Shell.EditSlot(slot)">Edit</button>
                    <button class="btn btn-danger" disabled="@(!Shell.IsRunning(slot))" @onclick="() => Shell.CloseSlot(slot)">X</button>
                    <button class="btn btn-ghost" disabled="@Shell.SlotsLocked" @onclick="() => Shell.DeleteSlot(slot)" title="Remove saved slot">Del</button>
                </div>
            </div>
        }

        @if (Shell.Editor is { } editor)
        {
            <div class="slot-edit">
                <div class="eyebrow">Slot</div>
                <div class="field-row"><label>Account</label><input @bind="editor.Account" /></div>
                <div class="field-row"><label>Password</label><input type="password" @bind="Shell.EditorPassword" placeholder="unchanged if empty" /></div>
                <div class="field-row">
                    <label>Character slot</label>
                    <select @bind="editor.CharacterSlot">
                        @for (var i = 0; i < 5; i++)
                        {
                            <option value="@i">@(i + 1)</option>
                        }
                    </select>
                </div>
                <div class="field-row">
                    <label>Channel</label>
                    <select @bind="editor.ChannelIndex">
                        @foreach (var channel in Shell.Channels)
                        {
                            <option value="@channel.Index">@channel.Name</option>
                        }
                    </select>
                </div>
                <div class="field-row"><label>Character name</label><input @bind="editor.CharacterName" placeholder="filled in-game" /></div>
                <div class="slot-cmd">
                    <button class="btn btn-save" disabled="@Shell.SlotsLocked" @onclick="Shell.SaveEditor">Save</button>
                    <button class="btn" @onclick="Shell.CancelEdit">Cancel</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _themeApplied;

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_themeApplied)
        {
            _themeApplied = true;
            await Themes.SelectAsync(Themes.CurrentId, JS);
        }
    }

    private void OnProfileChanged(ChangeEventArgs e)
    {
        Shell.ProfileName = e.Value?.ToString() ?? Shell.ProfileName;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;
}
