@page "/ranged"
@implements IDisposable
@inject FarmBotShell Shell

<p class="lede compact">Blasts selected farm targets in one burst, then returns. Fast pickup and ranged pickup start as soon as they are ticked. The character does not walk.</p>

<label class="check-row"><input type="checkbox" @bind="Shell.Config.RangedAttackEnabled" /> Ranged attack</label>
<label class="check-row"><input type="checkbox" @bind="Shell.Config.RangedAvoidAttacks" /> Avoid attacks</label>
<label class="check-row"><input type="checkbox" @bind="Shell.Config.RangedPickupEnabled" /> Ranged pickup</label>
<label class="check-row"><input type="checkbox" @bind="Shell.Config.FastPickupEnabled" /> Fast pickup</label>
<div class="field-grid">
    <div class="field-row"><label>Radius</label><input type="number" min="0" step="25" @bind="Shell.Config.RangedAttackRadius" /></div>
    <div class="field-row"><label>Max targets</label><input type="number" @bind="Shell.Config.RangedAttackMaxTargets" /></div>
    <div class="field-row"><label>Attack delay ms</label><input type="number" @bind="Shell.Config.RangedAttackDelayMs" /></div>
    <div class="field-row"><label>Loot range</label><input type="number" min="0" step="25" @bind="Shell.Config.LootRange" /></div>
    <div class="field-row"><label>Fast pickup ms</label><input type="number" @bind="Shell.Config.FastPickupDelayMs" /></div>
    <div class="field-row"><label>Farm radius</label><input type="number" disabled value="@Shell.Config.FarmRadius.ToString("0")" /></div>
</div>
<label class="slider">
    <span>Fast pickup delay <b>@Shell.Config.FastPickupDelayMs ms</b></span>
    <input type="range" min="1" max="500" step="1" value="@Shell.Config.FastPickupDelayMs" @oninput="OnFastDelay" />
</label>

<div class="quick">
    <button class="btn btn-ok" disabled="@(Shell.RangedOnly)" @onclick="Shell.StartRanged">Start ranged</button>
    <button class="btn btn-danger" disabled="@(!Shell.RangedOnly)" @onclick="Shell.StopBot">Stop ranged</button>
</div>

<div class="tile compact">
    <div class="pot-label">@(Shell.RangedOnly ? "Following you" : Shell.Config.RangedAttackEnabled ? "Ranged targets" : "Ranged is off")</div>
    <p>@Status</p>
    <div class="table-shell">
        <div class="table-wrap short">
            <table class="grid">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>VID</th>
                        <th>Type</th>
                        <th>Name</th>
                        <th>Dist</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var n = 0; }
                    @foreach (var entity in Queue)
                    {
                        n++;
                        <tr class="@(Shell.View.Target?.Vid == entity.Vid ? "tgt" : null)">
                            <td>@n</td>
                            <td>@entity.Vid</td>
                            <td>@EntityMapping.TypeName(entity.ResolvedType)</td>
                            <td>@(string.IsNullOrWhiteSpace(entity.Name) ? "—" : entity.Name)</td>
                            <td>@entity.Distance.ToString("0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string Status
    {
        get
        {
            if (!Shell.Config.RangedAttackEnabled && !Shell.RangedOnly)
                return "Press Start ranged to blast around you as you walk, or turn the checkbox on and use Start to farm a locked circle.";
            var count = Queue.Count;
            var cap = Shell.Config.RangedAttackMaxTargets;
            return count == 0
                ? Shell.View.Reason
                : $"{count} of {cap} · {Shell.View.Reason}";
        }
    }

    private IReadOnlyList<EntityState> Queue
    {
        get
        {
            var snapshot = Shell.View.Snapshot;
            if (snapshot == null)
                return Array.Empty<EntityState>();
            return TargetSelector.SelectMany(
                snapshot,
                Shell.Config,
                Shell.Config.RangedAttackMaxTargets,
                Shell.Config.RangedAttackRadius,
                followPlayer: Shell.RangedOnly);
        }
    }

    private void OnFastDelay(ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var ms) && ms >= 1)
            Shell.Config.FastPickupDelayMs = ms;
    }

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;
}
