@page "/"
@implements IDisposable
@inject FarmBotShell Shell

<div class="eyebrow">Operations</div>
<div class="page-head">
    <h1>Farm</h1>
</div>

<div class="dash">
    <div class="tile">
        <div class="eyebrow">Player</div>
        <div class="player-name">@Name</div>
        <div class="player-meta">Lv @Level · @Position</div>
        <div class="meter">
            <span>EXP</span>
            <div class="track"><div class="fill exp" style="width:@Pct(Player?.Exp ?? 0, Player?.NextExp ?? 0)"></div></div>
            <b>@Frac(Player?.Exp, Player?.NextExp)</b>
        </div>
        <div class="meter">
            <span>HP</span>
            <div class="track"><div class="fill hp" style="width:@Pct(Player?.Hp ?? 0, Player?.MaxHp ?? 0)"></div></div>
            <b>@Frac(Player?.Hp, Player?.MaxHp)</b>
        </div>
        <div class="meter">
            <span>MP</span>
            <div class="track"><div class="fill mp" style="width:@Pct(Player?.Mp ?? 0, Player?.MaxMp ?? 0)"></div></div>
            <b>@Frac(Player?.Mp, Player?.MaxMp)</b>
        </div>
        @if (Shell.ShowPotions)
        {
            <div class="pots">
                <div class="pot-group">
                    <div class="pot-label">Red</div>
                    <div class="pot-row">
                        @foreach (var pot in Of(PotionFamily.Hp))
                        {
                            <button type="button" class="pot hp @(Sel(pot))" disabled="@(pot.Count <= 0)" title="@Tip(pot)" @onclick="() => Shell.TogglePotion(pot.Vnum)">
                                @if (HasIcon(pot))
                                {
                                    <img src="@pot.Icon" alt="@pot.Name" />
                                }
                                else
                                {
                                    <span class="pot-face">@SizeMark(pot.Name)</span>
                                }
                                <b>@pot.Count</b>
                            </button>
                        }
                        @if (!Of(PotionFamily.Hp).Any())
                        {
                            <span class="pot-empty">@(InGame ? "no red pots in bag" : "waiting for game")</span>
                        }
                        @if (Shell.Config.ClientProfile == ClientProfile.Baerim)
                        {
                            <button type="button" class="btn" title="Dump captcha backgrounds to C:\Temp\captcha-bgs" @onclick="Shell.DumpCaptchaBackgrounds">Dump BG</button>
                        }
                    </div>
                    <label class="pot-pct">HP <input type="number" min="0" max="100" value="@Shell.Config.PotionHpPercent.ToString("0")" @onchange="OnHpPct" /> %</label>
                </div>
                <div class="pot-group">
                    <div class="pot-label">Blue</div>
                    <div class="pot-row">
                        @foreach (var pot in Of(PotionFamily.Mp))
                        {
                            <button type="button" class="pot mp @(Sel(pot))" disabled="@(pot.Count <= 0)" title="@Tip(pot)" @onclick="() => Shell.TogglePotion(pot.Vnum)">
                                @if (HasIcon(pot))
                                {
                                    <img src="@pot.Icon" alt="@pot.Name" />
                                }
                                else
                                {
                                    <span class="pot-face">@SizeMark(pot.Name)</span>
                                }
                                <b>@pot.Count</b>
                            </button>
                        }
                        @if (!Of(PotionFamily.Mp).Any())
                        {
                            <span class="pot-empty">@(InGame ? "no blue pots in bag" : "waiting for game")</span>
                        }
                    </div>
                    <label class="pot-pct">MP <input type="number" min="0" max="100" value="@Shell.Config.PotionMpPercent.ToString("0")" @onchange="OnMpPct" /> %</label>
                </div>
                <div class="pot-group">
                    <div class="pot-label">Green / purple</div>
                    <div class="pot-row">
                        @foreach (var pot in SpeedPots)
                        {
                            <button type="button" class="pot @Css(pot.Family) @(Sel(pot))" disabled="@(pot.Count <= 0)" title="@Tip(pot)" @onclick="() => Shell.TogglePotion(pot.Vnum)">
                                @if (HasIcon(pot))
                                {
                                    <img src="@pot.Icon" alt="@pot.Name" />
                                }
                                else
                                {
                                    <span class="pot-face">@SizeMark(pot.Name)</span>
                                }
                                <b>@pot.Count</b>
                            </button>
                        }
                        @if (!SpeedPots.Any())
                        {
                            <span class="pot-empty">@(InGame ? "no speed pots in bag" : "waiting for game")</span>
                        }
                    </div>
                    @if (Shell.View.GreenRemain > 0 || Shell.View.PurpleRemain > 0)
                    {
                        <div class="pot-remain">
                            @if (Shell.View.GreenRemain > 0)
                            {
                                <span>green @Shell.View.GreenRemain s</span>
                            }
                            @if (Shell.View.PurpleRemain > 0)
                            {
                                <span>purple @Shell.View.PurpleRemain s</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        <div class="quick">
            <button class="btn btn-ok" disabled="@(Shell.View.Enabled)" @onclick="Shell.StartBot">Start bot</button>
            <button class="btn btn-danger" disabled="@(!Shell.View.Enabled)" @onclick="Shell.StopBot">Stop</button>
        </div>
    </div>
    <div class="tile">
        <div class="eyebrow">Map</div>
        <h2>@(Shell.IsLive ? "Live client" : "Simulator")</h2>
        <p>@(string.IsNullOrWhiteSpace(Player?.MapName) ? "Farm area around the player." : Player!.MapName)</p>
        <Minimap />
    </div>
    @if (Shell.ShowSkills)
    {
        <div class="tile wide">
            <div class="eyebrow">Skills</div>
            <h2>Learned</h2>
            @if (Shell.Skills.Count == 0)
            {
                <p class="pot-empty">@(InGame ? "no skills learned" : "waiting for game")</p>
            }
            else
            {
                <div class="skill-row">
                    @foreach (var skill in Shell.Skills)
                    {
                        <div class="skill">
                            <input type="checkbox" checked="@Shell.SkillEnabled(skill.Index)" title="Use @skill.Name" @onchange="() => Shell.ToggleSkill(skill.Index)" />
                            @if (HasSkillIcon(skill))
                            {
                                <img src="@skill.Icon" alt="@skill.Name" title="@skill.Name" />
                            }
                            else
                            {
                                <span class="pot-face @(Shell.SkillBuff(skill.Index) ? "green" : "hp")" title="@skill.Name">@skill.Level</span>
                            }
                            <label class="skill-buff" title="Buff: use on self">
                                <input type="checkbox" checked="@Shell.SkillBuff(skill.Index)" @onchange="() => Shell.ToggleSkillBuff(skill.Index)" />
                                buff
                            </label>
                            <span class="skill-name" title="@skill.Name">@skill.Name</span>
                            <input type="number" class="skill-delay" min="0" max="600" step="1" value="@Shell.SkillDelay(skill.Index)" title="Delay seconds" @onchange="e => OnSkillDelay(skill.Index, e)" />
                        </div>
                    }
                </div>
            }
        </div>
    }
    <div class="tile wide">
        <div class="eyebrow">Nearby</div>
        <h2>Entities (@(Shell.View.Snapshot?.Entities.Count ?? 0))</h2>
        <div class="table-shell" style="margin-top:12px">
            <div class="table-wrap short">
                <table class="grid">
                    <thead>
                        <tr>
                            <th>VID</th>
                            <th>Type</th>
                            <th>VNUM</th>
                            <th>Name</th>
                            <th>Dist</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entity in Entities)
                        {
                            <tr class="@(Shell.View.Target?.Vid == entity.Vid ? "tgt" : null)">
                                <td>@entity.Vid</td>
                                <td>@EntityMapping.TypeName(entity.ResolvedType)</td>
                                <td>@entity.Vnum</td>
                                <td>@(string.IsNullOrWhiteSpace(entity.Name) ? "—" : entity.Name)</td>
                                <td>@entity.Distance.ToString("0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private PlayerState? Player => Shell.View.Snapshot?.Player;

    private bool InGame => (Player?.MaxHp ?? 0) > 0;

    private string Name => string.IsNullOrWhiteSpace(Player?.Name) ? "—" : Player!.Name;

    private string Level => Player is { Level: > 0 } ? Player.Level.ToString() : "—";

    private string Position => Player == null ? "—" : $"{Player.X:0} , {Player.Y:0}";

    private IEnumerable<EntityState> Entities =>
        (Shell.View.Snapshot?.Entities ?? Array.Empty<EntityState>()).OrderBy(item => item.Distance);

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;

    private static string Frac(int? current, int? max) =>
        max is > 0 ? $"{current ?? 0} / {max}" : "—";

    private static string Pct(int current, int max)
    {
        if (max <= 0 || current <= 0)
            return "0%";
        return $"{Math.Clamp(100.0 * current / max, 0, 100):0}%";
    }

    private IEnumerable<PotionStack> Of(PotionFamily family) =>
        Shell.Potions.Where(item => item.Family == family);

    private IEnumerable<PotionStack> SpeedPots =>
        Shell.Potions.Where(item => item.Family is PotionFamily.Green or PotionFamily.Purple);

    private string Sel(PotionStack pot) => Shell.PotionEnabled(pot.Vnum) ? "on" : "";

    private static bool HasIcon(PotionStack pot) => !string.IsNullOrWhiteSpace(pot.Icon);

    private static string Css(PotionFamily family) => family switch
    {
        PotionFamily.Mp => "mp",
        PotionFamily.Green => "green",
        PotionFamily.Purple => "purple",
        _ => "hp"
    };

    private string Tip(PotionStack pot)
    {
        var text = string.IsNullOrWhiteSpace(pot.Tooltip) ? pot.Name : pot.Tooltip;
        var remain = pot.Family == PotionFamily.Green ? Shell.View.GreenRemain
            : pot.Family == PotionFamily.Purple ? Shell.View.PurpleRemain : 0;
        return remain > 0 ? $"{text} · {remain}s left" : text;
    }

    private static string SizeMark(string name)
    {
        if (name.Contains("(L)", StringComparison.OrdinalIgnoreCase) || name.Contains("Large", StringComparison.OrdinalIgnoreCase))
            return "L";
        if (name.Contains("(M)", StringComparison.OrdinalIgnoreCase) || name.Contains("Medium", StringComparison.OrdinalIgnoreCase))
            return "M";
        if (name.Contains("(S)", StringComparison.OrdinalIgnoreCase) || name.Contains("Small", StringComparison.OrdinalIgnoreCase))
            return "S";
        return "•";
    }

    private void OnHpPct(ChangeEventArgs e)
    {
        if (double.TryParse(Convert.ToString(e.Value), out var value))
            Shell.SetPotionHpPercent(value);
    }

    private void OnMpPct(ChangeEventArgs e)
    {
        if (double.TryParse(Convert.ToString(e.Value), out var value))
            Shell.SetPotionMpPercent(value);
    }

    private static bool HasSkillIcon(LearnedSkill skill) =>
        !string.IsNullOrWhiteSpace(skill.Icon) && skill.Icon.StartsWith("data:", StringComparison.OrdinalIgnoreCase);

    private void OnSkillDelay(uint index, ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var value))
            Shell.SetSkillDelay(index, value);
    }
}
