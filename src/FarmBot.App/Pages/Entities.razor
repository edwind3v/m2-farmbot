@page "/entities"
@implements IDisposable
@inject FarmBotShell Shell

<div class="entity-toolbar">
    <div class="filter-row">
        <button type="button" class="chip @On(EntityFilter.All)" @onclick="() => _filter = EntityFilter.All">All</button>
        <button type="button" class="chip @On(EntityFilter.Players)" @onclick="() => _filter = EntityFilter.Players">Players</button>
        <button type="button" class="chip @On(EntityFilter.Monsters)" @onclick="() => _filter = EntityFilter.Monsters">Monsters</button>
        <button type="button" class="chip @On(EntityFilter.Stones)" @onclick="() => _filter = EntityFilter.Stones">Stones</button>
        <button type="button" class="chip @On(EntityFilter.Bosses)" @onclick="() => _filter = EntityFilter.Bosses">Bosses</button>
        <button type="button" class="chip @On(EntityFilter.Npcs)" @onclick="() => _filter = EntityFilter.Npcs">NPCs</button>
        <button type="button" class="chip @On(EntityFilter.Drops)" @onclick="() => _filter = EntityFilter.Drops">Drops</button>
    </div>
    <div class="sort-row">
        <span>Sort</span>
        <button type="button" class="chip @(_sortByName ? "" : "on")" @onclick="() => _sortByName = false">Distance</button>
        <button type="button" class="chip @(_sortByName ? "on" : "")" @onclick="() => _sortByName = true">Name</button>
        <span class="grid-count">@Shown.Count()</span>
    </div>
</div>

<div class="table-shell entity-table">
    <div class="table-wrap short">
        <table class="grid">
            <thead>
                <tr>
                    <th>VID</th>
                    <th>Type</th>
                    <th>VNUM</th>
                    <th>Name</th>
                    <th>Dist</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entity in Shown)
                {
                    <tr class="@(Shell.View.Target?.Vid == entity.Vid ? "tgt" : null)">
                        <td>@entity.Vid</td>
                        <td>@EntityMapping.TypeName(entity.ResolvedType)</td>
                        <td>@entity.Vnum</td>
                        <td>@(string.IsNullOrWhiteSpace(entity.Name) ? "—" : entity.Name)</td>
                        <td>@entity.Distance.ToString("0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private enum EntityFilter { All, Players, Monsters, Stones, Bosses, Npcs, Drops }

    private EntityFilter _filter = EntityFilter.All;
    private bool _sortByName;

    private IEnumerable<EntityState> Shown
    {
        get
        {
            var bosses = Shell.BossVnums().ToHashSet();
            var items = (Shell.View.Snapshot?.Entities ?? Array.Empty<EntityState>())
                .Where(item => Matches(item, bosses));
            return _sortByName
                ? items.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ThenBy(item => item.Distance)
                : items.OrderBy(item => item.Distance);
        }
    }

    private string On(EntityFilter filter) => _filter == filter ? "on" : "";

    private bool Matches(EntityState entity, HashSet<uint> bosses)
    {
        return _filter switch
        {
            EntityFilter.Players => entity.Kind == EntityKind.Player || entity.ResolvedType == ActorType.Player,
            EntityFilter.Monsters => entity.Kind == EntityKind.Monster || entity.ResolvedType == ActorType.Enemy,
            EntityFilter.Stones => entity.Kind == EntityKind.Metin || entity.ResolvedType == ActorType.Stone,
            EntityFilter.Bosses => entity.Kind == EntityKind.Boss || bosses.Contains(entity.Vnum),
            EntityFilter.Npcs => entity.Kind == EntityKind.Npc || entity.ResolvedType == ActorType.Npc,
            EntityFilter.Drops => entity.Kind == EntityKind.Drop,
            _ => true
        };
    }

    protected override void OnInitialized() => Shell.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= OnChanged;
}
